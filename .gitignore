# iree-amd-aie specific (CI or otherwise).
*-build/
*-install/
kernel-doc

# lit test outputs written next to source tests when run in-tree (transient)
**/test/Output/

# Python
.env
*.pyc
**/.ipynb_checkpoints/
.pytype/
**/__pycache__/**

# Visual Studio files
.vs/
.vscode/
*.sdf
*.opensdf
*.VC.opendb
*.suo
*.user
*.code-workspace

# macOS files
.DS_Store

# CMake artifacts (root build tree only; unanchored `build/` also hid scripts/build/)
/build/
build-*/
Testing/

# Bazel artifacts
**/bazel-*

# Executables
*.exe
*.out

# Local-only config options
configured.bazelrc
user.bazelrc
version_info.json
CMakeUserPresets.json

# Dear ImGui Ini files
imgui.ini

# Emacs autosaves
*~
\#*\#

# Vim swap files
[._]*.sw[a-p]

# Source indexing files
compile_commands.json
.cache/clangd

# Build tool caches (ccache, pip, etc.)
/.cache/

# Language server configuration files
.clangd

# Pyenv files
.python-version
*.venv
.venv

# Python deployment artifacts
*.whl
*.egg-info

# Android Studio / Gradle files
.cxx
.gradle
gradlew
gradlew.bat
gradle/
local.properties

# Generated documentation files
mkdocs/site/
docs/website/site/

# Temporary files
iree/builtins/**/bin/*.ll
artifacts/

# Archive files
*.tar
*.tar.*

# VS Code DevContainer
.devcontainer/docker-compose.yml

# Local cache files
llvm-external-projects/iree-dialects/.cache

# pkgci artifacts
artifacts/

# Side effects of local patching/merging
*.orig
*.rej

# Claude Code (operator's host tool only; must never be committed)
.claude/

# Peano/llvm-aie is a downloaded artifact (build_tools/download_peano.sh), not source
/llvm-aie/
/llvm_aie-*.dist-info/

# pipeline_dump.py debug artifacts (scripts/debug), regenerated per run
/debug_out/

# Local scratch: throwaway experiment scripts and pipeline dumps. These grow to
# tens of GB, so keep them out of `git add -A` range.
/_local/
/scripts/debug/_*.sh
/scripts/debug/__pycache__/

# Model working dirs. Large model files are downloaded (see each model's
# README) and .mlir/.vmfb/.npy are regenerated per run; neither is committed.
# Small committed inputs (e.g. models/mlp_2layer/mlp_2layer.onnx) are unaffected.
/models/*/*.mlir
/models/*/*.vmfb
/models/*/*.npy
/models/vgg16/*.onnx
/models/bert_tiny/*.onnx
/models/bert_base/*.onnx
